# Angel One SmartAPI
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# Your network intercepts HTTPS (antivirus/ISP proxy) — leave this at 0 locally.
MEDALLION_SSL_VERIFY=0

# live | mock | offline | test
MEDALLION_MARKET_MODE=live

# Turso (optional — falls back to local SQLite when unset)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Single-user forward-test account id (see database_engine.register_user)
MEDALLION_DEFAULT_USER_ID=1

# Copy to Streamlit Community Cloud → App settings → Secrets
# (or local .streamlit/secrets.toml — never commit real secrets)

MEDALLION_MARKET_MODE = "live"
MEDALLION_SSL_VERIFY = "1"
MEDALLION_HYDRATE_BATCH = "12"
MEDALLION_FUND_BATCH = "4"

# Optional: cold-start restore after Cloud sleep/redeploy (hosted sqlite file URL)
# MEDALLION_SEED_DB_URL = "https://example.com/medallion_system.db"
# ^ No longer needed once TURSO_* below is set — Turso replaces this hack
#   with a database that never loses data on sleep/redeploy in the first place.

# --- Persistent database (Turso) -------------------------------------------
# Free account: https://turso.tech  ->  `turso db create medallion`
#                                    ->  `turso db show medallion` (for the URL)
#                                    ->  `turso db tokens create medallion` (for the token)
TURSO_DATABASE_URL = "libsql://your-database-name.turso.io"
TURSO_AUTH_TOKEN = "your-turso-auth-token"

# --- Live prices (Angel One SmartAPI) ---------------------------------------
# Free account + API app: https://smartapi.angelbroking.in/
# TOTP secret comes from enabling TOTP login in the Angel One app (Settings > TOTP)
ANGEL_API_KEY = "your-angel-one-api-key"
ANGEL_CLIENT_ID = "your-angel-one-client-id"
ANGEL_PASSWORD = "your-angel-one-password"
ANGEL_TOTP_SECRET = "your-angel-one-totp-secret"
